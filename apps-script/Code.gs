/* ---------- التقويم ---------- */
function addWorkHours_(from, hours) {
  const c = cal_(); let left = Number(hours) || 0; const d = new Date(from);
  for (let guard = 0; guard < 400 && left > 0; guard++) {
    if (isWorkDay_(d, c)) {
      const s = new Date(d); s.setHours(c.start, 0, 0, 0); const e = new Date(d); e.setHours(c.end, 0, 0, 0);
      const st = Math.max(s.getTime(), d.getTime());
      if (e.getTime() > st) { const avail = (e.getTime() - st) / 3600000; if (avail >= left) return new Date(st + left * 3600000); left -= avail; }
    }
    d.setDate(d.getDate() + 1); d.setHours(0, 0, 0, 0);
  }
  return d;
}
function calendarItems(token, ym) {
  const me = auth_(token); const m = String(ym || fmtDate_(new Date(), 'yyyy-MM'));
  const inM = function (d) { return d instanceof Date && fmtDate_(d, 'yyyy-MM') === m; };
  const items = [];
  table_('Transactions').forEach(function (t) { if (['closed', 'rejected'].indexOf(t.status) < 0 && inM(t.dueAt) && canAct_(me, t)) items.push({ date: fmtDate_(t.dueAt), kind: 'tx', title: t.title, ref: t.ref }); });
  table_('Assignments').forEach(function (a) { if (a.toEmail === me.email && ['done', 'cancelled'].indexOf(a.status) < 0) { const due = addWorkHours_(a.assignedAt, Number(a.slaHours) + (Number(a.pausedHours) || 0)); if (inM(due)) items.push({ date: fmtDate_(due), kind: 'asg', title: a.task, ref: a.ref }); } });
  table_('QuickTasks').forEach(function (q) { const d = q.due instanceof Date ? fmtDate_(q.due) : String(q.due || ''); if (q.toKey === me.email && q.status !== 'done' && d.slice(0, 7) === m) items.push({ date: d, kind: 'quick', title: q.title, ref: q.ref || '' }); });
  splitList_(settings_().holidays).forEach(function (h) { if (h.slice(0, 7) === m) items.push({ date: h, kind: 'holiday', title: 'إجازة رسمية' }); });
  return { month: m, items: items, workDays: cal_().days };
}

