/** يضبط الرموز السرية التي يكتبها المالك بنفسه في الخاصية STAFF_PINS بصيغة: اسم_الدخول:الرمز، مفصولة بفواصل أو أسطر.
 *  اسم الدخول = اسم المستخدم أو البريد أو الجوال. تُحذف الخاصية تلقائياً بعد التطبيق، ولا تُكتب الرموز في السجل. */
function applyStaffPins_() {
  const sp = PropertiesService.getScriptProperties(); const raw = String(sp.getProperty('STAFF_PINS') || '').trim();
  if (!raw) return;
  const done = [], bad = [];
  digits_(raw).replace(/[：﹕]/g, ':').split(/[,،;\n]+/).forEach(function (pair) {
    const i = pair.lastIndexOf(':'); if (i < 1) { if (pair.trim()) bad.push(pair.trim().slice(0, 3) + '…'); return; }
    const id = idKey_(pair.slice(0, i)); const pin = digits_(pair.slice(i + 1)).replace(/\s+/g, '');
    const u = table_('Users').filter(function (x) { return x.key === id || (x.username && String(x.username).toLowerCase() === id) || (id.indexOf('@') > 0 && String(x.email).toLowerCase() === id) || (id && phoneKey_(x.phone) === id); })[0];
    if (!u) { bad.push(pair.slice(0, i).trim() + ' (اسم الدخول غير موجود)'); return; }
    if (!/^\d{6,}$/.test(pin)) { bad.push(pair.slice(0, i).trim() + ' (الرمز يجب أن يكون أرقاماً فقط، 6 على الأقل؛ طوله الحالي ' + pin.length + ')'); return; }
    const salt = Utilities.getUuid();
    updateRow_('Users', u, { salt: salt, pinHash: pinHash_(salt, pin), mustChangePin: false, active: true, status: 'active' });
    audit_('editor', 'User', u.key, 'pin_set_by_owner', {});
    done.push(u.name);
  });
  if (!bad.length) sp.deleteProperty('STAFF_PINS');
  Logger.log('ضُبط الرمز السري لـ: ' + (done.join('، ') || '—') + (bad.length ? ' | لم يُطبق: ' + bad.join('، ') + ' — بقيت الخاصية STAFF_PINS لتصحيحها ثم إعادة التشغيل.' : ' — حُذفت الخاصية STAFF_PINS.'));
}
/** يُشغَّل من المحرر: يرسل دعوة جديدة برمز مؤقت لكل موظف لم يغيّر رمزه بعد (عدا المشرف العام).
 *  يحتاج إذن «إرسال البريد نيابةً عنك» — عند ظهور نافذة الأذونات اختر «تحديد الكل» ثم «متابعة». */
