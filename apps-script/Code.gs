  const fl = []; if (filters && filters.from) fl.push('من ' + filters.from); if (filters && filters.to) fl.push('إلى ' + filters.to); if (filters && filters.dept) fl.push('الإدارة: ' + filters.dept); if (filters && filters.status) fl.push('الحالة: ' + STATUS[filters.status]);
