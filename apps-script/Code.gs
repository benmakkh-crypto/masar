    deptPerf: Object.keys(deptPerf).map(function (d) { const o = deptPerf[d]; return { dept: d, done: o.done, open: o.open, onTime: o.done ? Math.round(o.onTime / o.done * 100) : null, avgHours: o.done ? Math.round(o.hours / o.done * 10) / 10 : null }; })
  };
}
