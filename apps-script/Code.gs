/* ---------- حسابات الفريق (من ملف Staff الخاص بالمشروع) ---------- */
function seedStaff_() {
  if (typeof STAFF_SEED === 'undefined' || !Array.isArray(STAFF_SEED)) return [];
  const sk = phoneKey_(SUPERVISOR.phone); const out = []; const staffVer = typeof STAFF_VERSION === 'undefined' ? '' : String(STAFF_VERSION);
  const depts = splitList_(settings_().departments);
  STAFF_SEED.forEach(function (p) { if (p.dept && depts.indexOf(p.dept) < 0) depts.splice(Math.max(0, depts.length - 1), 0, p.dept); });
  setSetting_('departments', depts.join(','));
  const ALLP = DEFAULT_PERMS.map(function (x) { return x[0]; });
  STAFF_SEED.forEach(function (p) {
    const email = String(p.email || '').trim().toLowerCase(); if (!email) return;
    if (p.supervisor) {
      const sup = userByKey_(sk); if (!sup) return;
      const other = table_('Users').filter(function (u) { return u.key !== sk && String(u.email).toLowerCase() === email; })[0];
      if (!other) updateRow_('Users', sup, { email: email, name: p.name || sup.name, jobTitle: p.jobTitle || sup.jobTitle });
      if (p.username && !table_('Users').some(function (u) { return u.key !== sk && String(u.username || '').toLowerCase() === p.username; })) updateRow_('Users', userByKey_(sk), { username: p.username });
      return;
    }
    const sup = userByKey_(sk); if (sup && String(sup.email).toLowerCase() === email) updateRow_('Users', sup, { email: '' });
    const ex = table_('Users').filter(function (u) { return u.key === email || String(u.email).toLowerCase() === email; })[0];
    if (ex) {
      if (staffVer && PropertiesService.getScriptProperties().getProperty('STAFF_APPLIED') !== staffVer) {
        const patch = {};
        if (p.phone && !table_('Users').some(function (u) { return u.key !== ex.key && phoneKey_(u.phone) === phoneKey_(p.phone); })) patch.phone = p.phone;
        if (p.username && !table_('Users').some(function (u) { return u.key !== ex.key && String(u.username || '').toLowerCase() === p.username; })) patch.username = p.username;
        if (p.jobTitle) patch.jobTitle = p.jobTitle;
        if (p.role && ROLES[p.role]) patch.role = p.role;
        if (p.dept) patch.dept = p.dept;
        if (p.allPerms) patch.permsAdd = ALLP.join(','); else if (p.permsAdd) patch.permsAdd = p.permsAdd.join(',');
        if (Object.keys(patch).length) { updateRow_('Users', ex, patch); audit_('setup', 'User', ex.key, 'staff_update', { fields: Object.keys(patch) }); Logger.log('حُدّث: ' + p.name + ' — اسم المستخدم: ' + (patch.username || ex.username || '') + ' — ' + Object.keys(patch).join(', ')); }
      }
      return;
    }
    const pin = String(Math.floor(100000 + Math.random() * 900000)); const salt = Utilities.getUuid();
    appendRow_('Users', { key: email, username: p.username || '', email: email, phone: p.phone || '', name: p.name, role: ROLES[p.role] ? p.role : 'employee', dept: p.dept, jobTitle: p.jobTitle || '', managerKey: p.manager ? (p.manager === 'supervisor' ? sk : String(p.manager).toLowerCase()) : '', active: true, status: 'active', salt: salt, pinHash: pinHash_(salt, pin), mustChangePin: true, permsAdd: p.allPerms ? ALLP.join(',') : (p.permsAdd || []).join(','), permsRemove: '', createdAt: new Date(), createdBy: 'setup' });
    audit_('setup', 'User', email, 'create_staff', { role: p.role });
    invite_(email, p.name, email, pin);
    Logger.log('حساب: ' + p.name + ' — اسم الدخول: ' + email + ' — الرمز المؤقت: ' + pin);
    out.push(email);
  });
  if (staffVer) PropertiesService.getScriptProperties().setProperty('STAFF_APPLIED', staffVer);
  return out;
}

