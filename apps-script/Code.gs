    if (b.caption) { sh.getRange(r, 1, 1, b.head.length).merge().setValue(b.caption).setFontWeight('bold').setFontSize(13).setFontColor('#a87a2c').setHorizontalAlignment('right'); r++; }
    sh.getRange(r, 1, 1, b.head.length).setValues([b.head]).setFontWeight('bold').setBackground('#0f3d2e').setFontColor('#ffffff').setHorizontalAlignment('center').setWrap(true);
    if (b.rows.length) {
      const rg = sh.getRange(r + 1, 1, b.rows.length, b.head.length); rg.setValues(b.rows.map(safeRow_)).setHorizontalAlignment('right').setVerticalAlignment('middle');
      for (let i = 0; i < b.rows.length; i += 2) sh.getRange(r + 1 + i, 1, 1, b.head.length).setBackground('#f1f5f3');
      sh.getRange(r, 1, b.rows.length + 1, b.head.length).setBorder(true, true, true, true, true, true, '#d5dddb', SpreadsheetApp.BorderStyle.SOLID);
    } else { sh.getRange(r + 1, 1).setValue('لا توجد بيانات مطابقة.'); }
    r += b.rows.length + 3;
  });
  sh.getRange(r, 1, 1, width).merge().setValue('الإجمالي: ' + data.blocks.map(function (b) { return (b.caption ? b.caption + ' ' : '') + b.rows.length; }).join(' · ') + ' — منظومة مسار').setFontColor('#5b6d70');
  sh.autoResizeColumns(1, width);
  for (let c = 1; c <= width; c++) if (sh.getColumnWidth(c) > 260) sh.setColumnWidth(c, 260);
  sh.getRange(1, 1, r, width).setFontFamily('Tajawal');
  SpreadsheetApp.flush();
  const url = 'https://docs.google.com/spreadsheets/d/' + ss.getId() + '/export?' + (format === 'pdf'
    ? 'format=pdf&size=A4&portrait=false&fitw=true&gridlines=false&printtitle=false&sheetnames=false&pagenum=CENTER&top_margin=0.5&bottom_margin=0.5&left_margin=0.4&right_margin=0.4'
    : 'format=xlsx');
  const resp = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true });
  if (resp.getResponseCode() !== 200) { DriveApp.getFileById(ss.getId()).setTrashed(true); throw new Error('تعذر إنشاء الملف (' + resp.getResponseCode() + ').'); }
  const mime = format === 'pdf' ? 'application/pdf' : 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
  const fileName = name + (format === 'pdf' ? '.pdf' : '.xlsx');
  const blob = resp.getBlob().setName(fileName).setContentType(mime);
  const saved = folderIn_(rootFolder_(), 'مسار | التقارير').createFile(blob);
