function runEscalations(e) {
  trig_(e);
  const now = new Date(); const c = cal_();
  if (!isWorkDay_(now, c)) return;
  table_('Assignments').forEach(function (a) {
    if (['done', 'cancelled', 'paused'].indexOf(a.status) >= 0) return;
    const tm = asgTimes_(a, now); const last = Number(a.lastLevel) || 0;
    if (!(a.acceptedAt instanceof Date) && workHours_(a.assignedAt, now) >= Number(settings_().implicitAcceptHours)) {
      updateRow_('Assignments', a, { acceptedAt: now, status: 'accepted' });
      log_({ email: 'system', name: 'النظام' }, a.ref, a.id, 'ACC', 'استلام ضمني بعد انقضاء المهلة', '', '', false);
    }
    const lv = tm.pct >= 150 ? 5 : tm.pct >= 125 ? 4 : tm.pct >= 100 ? 3 : tm.pct >= 90 ? 2 : tm.pct >= 75 ? 1 : 0;
    if (lv <= last) return;
    const emp = userByKey_(a.toEmail) || {};
    const to = [a.toEmail];
    if (lv >= 2 && emp.managerKey) to.push(emp.managerKey);
    if (lv >= 3) to.push(deptHead_(a.dept));
    if (lv >= 5) table_('Users').forEach(function (u) { if (u.active === true && ['gm', 'deputy', 'supervisor', 'sysadmin'].indexOf(u.role) >= 0) to.push(u.key); });
    const msg = ['', 'تذكير: استُهلك 75% من مدة التكليف', 'تنبيه عاجل: استُهلك 90% من المدة', 'إشعار تأخير: تجاوز التكليف موعده', 'تصعيد إداري: استمرار التأخير', 'متابعة مباشرة من الإدارة العليا'][lv];
    to.filter(function (x, i) { return x && to.indexOf(x) === i; }).forEach(function (k) { notify_(k, a.ref, a.id, lv, msg + ' — ' + a.task + ' (' + tm.pct + '%)'); });
    updateRow_('Assignments', a, { lastLevel: lv });
  });
}
