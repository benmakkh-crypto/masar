  const me = auth_(token); const m = String(ym || fmtDate_(new Date(), 'yyyy-MM'));
  const rows = table_('Attendance').filter(function (r) { return r.key === me.email && attPlain_(r).date.slice(0, 7) === m; }).map(attPlain_).sort(function (a, b) { return b.date.localeCompare(a.date); });
  const today = attRow_(me.email, fmtDate_(new Date()));
