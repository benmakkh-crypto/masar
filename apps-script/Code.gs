        'يمكنكم الاطّلاع على المحضر الرسمي كاملاً وتأكيد اطّلاعكم عبر الرابط الآمن التالي، كما يمكنكم تحميله PDF أو طباعته مباشرةً من الصفحة:<br><br>' +
        '<a href="' + link + '" style="display:inline-block;background:#0b1b3f;color:#fff;text-decoration:none;font-weight:bold;border-radius:10px;padding:10px 22px">اطّلاع على المحضر</a><br><br>' +
        '<small style="color:#64748b">أو انسخ الرابط: ' + link + '</small><br><br>' +
        'مع خالص التقدير،<br><b>مسار — شركة بنيان العالمية</b></div>';
      try { sendMail_({ to: g.email, subject: 'محضر اجتماع ' + (r.title || '') + ' — ' + ref, htmlBody: body, name: 'مسار — شركة بنيان العالمية', attachments: atts }); g.sentAt = now.toISOString(); sent++; } catch (e) { }
    });
    updateRow_('MtgMeet', r, { guests: JSON.stringify(gs), doc: doc });
    var d = RPC_.mtgBoard(token); try { d.sentCount = sent; } catch (e) { }
    return d;
  };
  RPC_.mtgPublic = function (token) {
    var f = mtgFindByToken_(token); if (!f) throw new Error('تعذّر العثور على المحضر أو انتهت صلاحية الرابط.');
    return { doc: String(f.row.doc || ''), title: String(f.row.title || ''), guest: String(f.guest.name || f.guest.email || ''), signed: !!f.guest.signedAt, signedAt: f.guest.signedAt ? String(f.guest.signedAt).slice(0, 10) : '' };
  };
  RPC_.mtgGuestSign = function (token) {
    var f = mtgFindByToken_(token); if (!f) throw new Error('رابط غير صالح.');
    if (!f.guest.signedAt) { f.guest.signedAt = new Date().toISOString(); f.guest.sign = 'اطّلاع'; updateRow_('MtgMeet', f.row, { guests: JSON.stringify(f.guests) }); }
    return { ok: true, signedAt: String(f.guest.signedAt).slice(0, 10) };
  };
})();
