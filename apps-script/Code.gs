  const data = reportData_(me, kind, filters);
  const s = settings_(); const stamp = Utilities.formatDate(new Date(), APP.tz, 'yyyy-MM-dd HH:mm');
  const name = data.title + ' — ' + Utilities.formatDate(new Date(), APP.tz, 'yyyy-MM-dd_HHmm');
