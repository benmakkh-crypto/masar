/* ---------- الاطلاع المفتوح وطلبات التعديل ---------- */
function editRequest(token, ref, text, files) {
  const me = auth_(token); const t = txByRef_(ref);
  if (!canSee_(me, t)) throw new Error('هذه المعاملة خارج نطاق اطلاعك.');
  text = String(text || '').trim(); if (text.length < 3) throw new Error('اكتب وصف التعديل المطلوب.');
  throttle_('req_' + me.email, 20, 3600);
  const urls = (files || []).slice(0, 5).map(function (f) { checkUpload_(f); return saveFile_(ref, f); });
  const open = table_('Assignments').filter(function (a) { return a.ref === ref && ['done', 'cancelled'].indexOf(a.status) < 0; });
  const to = (open.length ? open.map(function (a) { return a.toEmail; }) : [t.ownerEmail]).filter(function (k, i, a) { return k && k !== me.email && a.indexOf(k) === i; });
  if (!to.length) throw new Error('لا يوجد موظف مختص آخر لهذه المعاملة.');
  const id = 'RQ-' + Utilities.getUuid().slice(0, 6);
  to.forEach(function (k) {
    appendRow_('Requests', { id: id, ref: ref, fromKey: me.email, toKey: k, text: text.slice(0, 2000), fileUrls: urls.join('\n'), status: 'open', at: new Date() });
    appendRow_('Messages', { id: 'M-' + Utilities.getUuid().slice(0, 8), fromKey: me.email, toKey: k, body: '✎ طلب تعديل على المعاملة ' + ref + ':\n' + text.slice(0, 1800), at: new Date(), read: false });
    notify_(k, ref, '', 1, 'طلب تعديل من ' + me.name + ': ' + text.slice(0, 120));
  });
  log_(me, ref, '', 'REQ', 'طلب تعديل للموظف المختص', text.slice(0, 500), urls[0] || '', false);
  urls.slice(1).forEach(function (u) { log_(me, ref, '', 'ATT', 'مرفق مع طلب التعديل', '', u, false); });
  audit_(me.email, 'Transaction', ref, 'edit_request', { to: to });
  return { sentTo: to.map(userName_) };
}
function myRequests(token) {
  const me = auth_(token);
  return table_('Requests').filter(function (r) { return r.toKey === me.email || r.fromKey === me.email; }).map(function (r) {
    const o = plain_(r); o.fromName = userName_(r.fromKey); o.toName = userName_(r.toKey); o.mine = r.toKey === me.email;
    o.title = (table_('Transactions').filter(function (t) { return t.ref === r.ref; })[0] || {}).title || ''; return o;
  }).sort(function (a, b) { return b.at.localeCompare(a.at); }).slice(0, 200);
}
function answerRequest(token, id, status, reply) {
  const me = auth_(token);
  const rows = table_('Requests').filter(function (r) { return r.id === id && r.toKey === me.email; }); if (!rows.length) throw new Error('الطلب غير موجود.');
  if (['done', 'rejected'].indexOf(status) < 0) throw new Error('حالة غير صحيحة.');
  rows.forEach(function (r) { updateRow_('Requests', r, { status: status, reply: String(reply || '').slice(0, 1000), closedAt: new Date() }); });
  const r = rows[0];
  notify_(r.fromKey, r.ref, '', 0, (status === 'done' ? 'نُفّذ طلب التعديل' : 'اعتُذر عن طلب التعديل') + ' — ' + r.ref + (reply ? ': ' + String(reply).slice(0, 100) : ''));
  log_(me, r.ref, '', 'REQ', status === 'done' ? 'نُفّذ طلب التعديل' : 'رُفض طلب التعديل', String(reply || ''), '', false);
  return myRequests(token);
}

/* ---------- إرفاق ملفات (PDF وصور) مع رسالة ---------- */
const UPLOAD_TYPES = ['application/pdf', 'image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/heic'];
function checkUpload_(f) {
  if (!f || !f.data) throw new Error('ملف فارغ.');
  if (UPLOAD_TYPES.indexOf(String(f.mime || '').toLowerCase()) < 0) throw new Error('المسموح: PDF أو صور فقط — ' + (f.name || ''));
  if (f.data.length > 14 * 1024 * 1024) throw new Error('حجم الملف أكبر من 10 ميجابايت: ' + (f.name || ''));
}
function addAttachment(token, ref, text, files) {
  const me = auth_(token); const t = txByRef_(ref);
  if (!canAct_(me, t)) throw new Error('الإرفاق لأطراف المعاملة فقط. استخدم «طلب تعديل» لمراسلة الموظف المختص.');
  text = String(text || '').trim(); files = (files || []).slice(0, 8);
  if (!text && !files.length) throw new Error('اكتب رسالة أو أرفق ملفاً.');
  files.forEach(checkUpload_);
  if (text) log_(me, ref, '', 'NOTE', 'رسالة', text.slice(0, 2000), '', false);
  files.forEach(function (f) { log_(me, ref, '', 'ATT', 'إرفاق ملف', String(f.name || '').slice(0, 150), saveFile_(ref, f), false); });
  const others = table_('Assignments').filter(function (a) { return a.ref === ref && ['done', 'cancelled'].indexOf(a.status) < 0; }).map(function (a) { return a.toEmail; }).concat([t.ownerEmail])
    .filter(function (k, i, a) { return k && k !== me.email && a.indexOf(k) === i; });
  others.forEach(function (k) { notify_(k, ref, '', 0, me.name + ' أضاف ' + (files.length ? files.length + ' مرفق' : 'رسالة') + ' على ' + ref); });
  audit_(me.email, 'Transaction', ref, 'attach', { files: files.length, text: !!text });
  return getTransaction(token, ref);
}

/* ---------- الملخص اليومي بالبريد ---------- */
function installDigestTrigger_() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'sendDailyDigests') ScriptApp.deleteTrigger(t); });
  const s = settings_(); if (s.dailyDigest === 'false') return;
  ScriptApp.newTrigger('sendDailyDigests').timeBased().everyDays(1).atHour(Number(s.digestHour) || 7).inTimezone(APP.tz).create();
}
function digestFor_(u, now) {
  const me = { email: u.key, name: u.name, role: u.role, dept: u.dept, perms: userPerms_(u) };
  const mineA = table_('Assignments').filter(function (a) { return a.toEmail === u.key && ['done', 'cancelled'].indexOf(a.status) < 0; })
    .map(function (a) { const tm = asgTimes_(a, now); return { ref: a.ref, task: a.task, pct: tm.pct, title: (txByRefSafe_(a.ref) || {}).title || '' }; }).sort(function (a, b) { return b.pct - a.pct; });
  const review = table_('Assignments').filter(function (a) { return a.status === 'review' && a.fromEmail === u.key; }).map(function (a) { return { ref: a.ref, task: a.task }; });
  const act = table_('Transactions').filter(function (t) { return ['closed', 'rejected'].indexOf(t.status) < 0 && canAct_(me, t); });
  const awaiting = act.filter(function (t) { return (t.status === 'routing' && me.perms.route) || (t.status === 'finalApproval' && me.perms.close && approvalOk_(me, t)) || (t.status === 'adminDone' && me.perms.fin_settle); });
  const quick = table_('QuickTasks').filter(function (q) { return q.toKey === u.key && q.status !== 'done'; });
  const reqs = table_('Requests').filter(function (r) { return r.toKey === u.key && r.status === 'open'; });
  return { mine: mineA, review: review, awaiting: awaiting.map(function (t) { return { ref: t.ref, title: t.title, status: STATUS[t.status] }; }), quick: quick.map(function (q) { return { title: q.title, due: q.due instanceof Date ? fmtDate_(q.due) : String(q.due || '') }; }), requests: reqs.map(function (r) { return { ref: r.ref, text: String(r.text).slice(0, 120), from: userName_(r.fromKey) }; }), openInScope: act.length };
}
function txByRefSafe_(ref) { return table_('Transactions').filter(function (x) { return x.ref === ref; })[0]; }
function digestHtml_(u, d, s) {
  const url = loginUrl_();
  const sec = function (title, color, rows) { return rows.length ? '<h3 style="margin:18px 0 8px;color:' + color + ';font-size:16px">' + title + ' (' + rows.length + ')</h3><table style="width:100%;border-collapse:collapse;font-size:14px">' + rows.join('') + '</table>' : ''; };
  const tr = function (a, b, c) { return '<tr><td style="padding:7px 8px;border-bottom:1px solid #e5ece8;font-family:Consolas,monospace;color:#6d28d9;white-space:nowrap">' + (a || '') + '</td><td style="padding:7px 8px;border-bottom:1px solid #e5ece8">' + b + '</td><td style="padding:7px 8px;border-bottom:1px solid #e5ece8;text-align:left;white-space:nowrap">' + (c || '') + '</td></tr>'; };
  const late = d.mine.filter(function (a) { return a.pct >= 100; }).length;
  return '<div dir="rtl" style="font-family:Tahoma,Arial;max-width:680px;margin:auto;color:#11231c">' +
    '<div style="background:linear-gradient(120deg,#0a2a1f,#0f766e);color:#fff;border-radius:16px;padding:20px 22px"><div style="font-size:13px;color:#fde68a">' + s.companyName + ' · الملخص اليومي</div><div style="font-size:22px;font-weight:bold;margin-top:4px">صباح الخير ' + u.name + '</div>' +
    '<div style="margin-top:8px;font-size:14px">لديك ' + d.mine.length + ' تكليف جارٍ' + (late ? ' · <b style="color:#fecaca">' + late + ' متأخر</b>' : '') + ' · ' + d.awaiting.length + ' بانتظار قرارك · ' + d.quick.length + ' مهمة سريعة</div></div>' +
    sec('تكليفاتك الجارية', '#1d4ed8', d.mine.map(function (a) { return tr(a.ref, a.task + '<br><small style="color:#5f6f69">' + a.title + '</small>', '<b style="color:' + (a.pct >= 100 ? '#be123c' : a.pct >= 75 ? '#b45309' : '#15803d') + '">' + a.pct + '%</b>'); })) +
    sec('بانتظار قرارك', '#6d28d9', d.awaiting.map(function (t) { return tr(t.ref, t.title, t.status); }).concat(d.review.map(function (a) { return tr(a.ref, 'مراجعة: ' + a.task, 'بانتظار مراجعتك'); }))) +
    sec('طلبات تعديل موجهة لك', '#be123c', d.requests.map(function (r) { return tr(r.ref, r.text, r.from); })) +
    sec('مهامك السريعة', '#b45309', d.quick.map(function (q) { return tr('', q.title, q.due); })) +
    '<p style="margin-top:22px"><a href="' + url + '" style="background:#0f766e;color:#fff;text-decoration:none;padding:10px 20px;border-radius:10px;display:inline-block">فتح النظام</a></p>' +
    '<p style="color:#8a9a93;font-size:12px">يصلك هذا الملخص يومياً في أيام العمل. يمكن للمشرف العام إيقافه من «النظام الأساسي».</p></div>';
}
function sendDailyDigests(e) { trig_(e); return digestRun_(false).mail; }
/* التذكير اليومي: بريد لكل موظف + واتساب لكل موظف + ملخص لقروب الواتساب */
function digestRun_(force) {
  const s = settings_(); const now = new Date(); const out = { mail: 0, wa: 0, group: false };
  if (!force && (s.dailyDigest === 'false' || !isWorkDay_(now, cal_()))) return out;
  const wa = waOn_();
  table_('Users').filter(function (u) { return u.active === true && u.status !== 'pending'; }).forEach(function (u) {
    const d = digestFor_(u, now); if (!d.mine.length && !d.awaiting.length && !d.quick.length && !d.requests.length && !d.review.length) return;
    if (u.email && s.emailEnabled !== 'false' && MailApp.getRemainingDailyQuota() >= 3) { try { sendMail_({ to: u.email, subject: '[' + s.companyName + '] ملخصك اليومي — ' + d.mine.length + ' تكليف، ' + d.awaiting.length + ' بانتظار قرارك', htmlBody: digestHtml_(u, d, s) }); out.mail++; } catch (e) { } }
    if (wa && s.waPersonalDigest !== 'false' && u.phone) { if (waSend_(phoneIntl_(u.phone, userCountry_(u)), waDigestText_(u, d, s)).ok) out.wa++; }
  });
  if (wa && s.waGroupDigest !== 'false' && prop_('WA_GROUP')) out.group = waSend_(prop_('WA_GROUP'), waGroupDigestText_(s)).ok;
  audit_('system', 'Digest', fmtDate_(now), 'sent', out);
  return out;
}
function digestPreview(token, send) {
  const me = auth_(token); const u = userByKey_(me.email); const s = settings_();
  const d = digestFor_(u, new Date());
  if (send) { if (!u.email) throw new Error('أضف بريدك من «ملفي الشخصي» أولاً.'); sendMail_({ to: u.email, subject: '[' + s.companyName + '] ملخصك اليومي (تجربة)', htmlBody: digestHtml_(u, d, s) }); }
  return { html: digestHtml_(u, d, s), counts: { mine: d.mine.length, awaiting: d.awaiting.length, quick: d.quick.length, requests: d.requests.length }, sent: !!send };
}

/* ---------- الحضور والانصراف ---------- */
function attRow_(key, day) { return table_('Attendance').filter(function (r) { return r.key === key && (r.date instanceof Date ? fmtDate_(r.date) : String(r.date)) === day; })[0]; }
function attPlain_(r) { const o = plain_(r); o.date = r.date instanceof Date ? fmtDate_(r.date) : String(r.date); o.name = userName_(r.key); const u = userByKey_(r.key) || {}; o.dept = u.dept || ''; return o; }
