/* ---------- الشريط الإخباري ---------- */
function tickerItems_(me) {
  const today = fmtDate_(new Date()); const auto = splitList_(settings_().tickerAuto || 'alert,kudos,course,job,news');
  const items = newsList_().filter(function (n) { const until = !n.until ? '' : (isNaN(new Date(n.until).getTime()) ? String(n.until).slice(0, 10) : fmtDate_(new Date(n.until))); return (n.ticker === true || n.kind === 'ticker' || ((n.pinned === true || n.kind === 'circular') && auto.indexOf('news') >= 0)) && (!until || until >= today); }).slice(0, 12).map(function (n) { return { kind: n.kind, text: n.title, color: n.color || '', icon: n.icon || '', id: n.id }; });
  const jobs = table_('Jobs').filter(jobOpen_).slice(0, 3).map(function (j) { return { kind: 'job', text: 'وظيفة شاغرة: ' + j.title + ' — ' + j.dept }; });
  const since = new Date(Date.now() - 4 * 864e5);
  const kud = table_('Kudos').filter(function (k) { return k.public === true && k.at >= since; }).slice(-4).map(function (k) { return { kind: 'kudos', text: 'شكر وتقدير: ' + userName_(k.toKey) + ' — ' + String(k.reason).slice(0, 60) }; });
  const crs = table_('Courses').filter(function (c) { return c.active !== false && c.status === 'open'; }).slice(0, 3).map(function (c) { return { kind: 'course', text: 'التسجيل مفتوح: ' + c.title + (c.startDate ? ' — ' + (c.startDate instanceof Date ? fmtDate_(c.startDate) : c.startDate) : '') }; });
  const c = me ? counts_(me) : null;
  const sys = c && c.late && auto.indexOf('alert') >= 0 ? [{ kind: 'alert', text: 'تنبيه: ' + c.late + ' معاملة متأخرة ضمن نطاقك' }] : [];
  return sys.concat(auto.indexOf('kudos') >= 0 ? kud : [], items, auto.indexOf('course') >= 0 ? crs : [], auto.indexOf('job') >= 0 ? jobs : []);
}
