/* =========================================================
 * التحديث الذاتي من GitHub (يحتاج تفعيل Google Apps Script API من إعدادات المستخدم)
 * ========================================================= */
const UPD_REPO_ = 'benmakkh-crypto/masar';
const UPD_FILES_ = { 'Code.gs': ['SERVER_JS', null], 'Index.html': ['HTML', 'Index'], 'Public.html': ['HTML', 'Public'], 'I18n.html': ['HTML', 'I18n'], 'appsscript.json': ['JSON', 'appsscript'] };
function updLatest_() {
  const r = UrlFetchApp.fetch('https://api.github.com/repos/' + UPD_REPO_ + '/commits/main', { muteHttpExceptions: true, headers: { Accept: 'application/vnd.github+json' } });
  if (r.getResponseCode() !== 200) throw new Error('تعذر الوصول إلى GitHub (' + r.getResponseCode() + ').');
  const j = JSON.parse(r.getContentText());
  return { sha: j.sha, short: String(j.sha).slice(0, 7), message: String((j.commit && j.commit.message) || '').split('\n')[0].slice(0, 160), date: j.commit && j.commit.author ? j.commit.author.date : '' };
}
function updState_() {
  const p = PropertiesService.getScriptProperties();
  return { sha: p.getProperty('UPD_SHA') || '', at: p.getProperty('UPD_AT') || '', auto: p.getProperty('UPD_AUTO') === 'true', last: p.getProperty('UPD_LAST') || '', deploymentId: p.getProperty('UPD_DEPLOYMENT') || '' };
}
function checkForUpdate(token) {
  const me = auth_(token); need_(me, 'manage_settings');
  const st = updState_(); let latest = null, error = '';
  try { latest = updLatest_(); } catch (e) { error = e.message; }
  return { current: { version: APP.version, sha: st.sha ? st.sha.slice(0, 7) : '', at: st.at }, latest: latest, available: !!latest && latest.sha !== st.sha, auto: st.auto, last: st.last, error: error };
}
function setAutoUpdate(token, on) {
  const me = auth_(token); need_(me, 'manage_settings');
  if (on) throw new Error('التحديث الذاتي من المستودع العام معطّل لأسباب أمنية؛ التحديثات تُنشر يدوياً بعد مراجعتها واختبارها.');
  PropertiesService.getScriptProperties().setProperty('UPD_AUTO', 'false');
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'autoUpdate') ScriptApp.deleteTrigger(t); });
  if (on) ScriptApp.newTrigger('autoUpdate').timeBased().everyDays(1).atHour(3).create();
  audit_(me.email, 'System', 'update', on ? 'auto_on' : 'auto_off', {});
  return checkForUpdate(token);
}
function runUpdate(token) {
  const me = auth_(token); need_(me, 'manage_settings');
  audit_(me.email, 'System', 'update', 'blocked', {});
  throw new Error('التحديث الذاتي من المستودع العام معطّل لأسباب أمنية؛ التحديثات تُنشر يدوياً بعد مراجعتها واختبارها.');
}
/** يُشغَّل مرة من المحرر: يطلب أذونات التحديث الذاتي ويتحقق من تفعيل Apps Script API */
function authorizeUpdates() {
  ownerOnly_();
  try { ScriptApp.requireAllScopes(ScriptApp.AuthMode.FULL); } catch (e) { Logger.log('امنح الأذونات المطلوبة (اختر «تحديد الكل») ثم شغّل الدالة مرة أخرى.'); throw e; }
  const res = UrlFetchApp.fetch('https://script.googleapis.com/v1/projects/' + ScriptApp.getScriptId(), { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true });
